{
  "name": "mi-chi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check:mock": "node --import tsx scripts/check-mock.ts",
    "db:setup": "node scripts/database.mjs db push",
    "db:generate": "node scripts/database.mjs generate",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "cf:build": "npm run db:generate && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.7",
    "@prisma/adapter-d1": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "next": "^15.5.27",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.146.0"
  }
}
