# Local SQLite demo; use a postgresql:// URL for Postgres.
DATABASE_URL=file:./dev.db
NEXTAUTH_URL=http://127.0.0.1:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Google Cloud Console OAuth web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HubSpot public app OAuth credentials
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://127.0.0.1:3000/api/hubspot/callback
# Dealroom server-side bearer key and supplied client identifier
DEALROOM_API_KEY=
DEALROOM_BASE_URL=https://api.beta.dealroom.app
DEALROOM_CLIENT_ID=
# Optional supplied Dealroom OAuth file instead of a bearer key
DEALROOM_ENV_FILE=
# Exactly32 random bytes encoded as64 hex characters: openssl rand -hex 32
ENCRYPTION_KEY=
MOCK_MODE=true
