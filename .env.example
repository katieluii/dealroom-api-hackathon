# true uses labelled fixtures; false requests Dealroom and visibly falls back on failure.
MOCK_MODE=true
DEALROOM_BASE_URL=https://api.beta.dealroom.app
# Optional bearer token supplied by Dealroom. The downloaded hackathon key uses OAuth instead.
DEALROOM_API_KEY=
# Required with a bearer token; OAuth credentials files already contain this.
DEALROOM_CLIENT_ID=
# Local path to the downloaded OAuth credentials file; never expose it to the browser.
DEALROOM_ENV_FILE=
# Anthropic Console > API keys. Without this, demo commands work and are labelled as scripted.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
